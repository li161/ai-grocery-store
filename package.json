{
  "name": "ai-grocery-store",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,mjs,vue,css}\" \"scripts/**/*.{js,mjs}\" \"services/**/*.{js,mjs,json}\" \"package.json\" \"eslint.config.js\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs,vue,css}\" \"scripts/**/*.{js,mjs}\" \"services/**/*.{js,mjs,json}\" \"package.json\" \"eslint.config.js\" \".prettierrc.json\"",
    "test:unity-contract": "node scripts/test-unity-scene-contract.mjs",
    "check": "npm run format:check && npm run lint && npm run test:unity-contract && npm run build",
    "sync:retail": "node scripts/sync-retail-news.mjs",
    "sync:platform": "node scripts/sync-platform-actions.mjs",
    "predev": "node scripts/fetch-render-assets.mjs",
    "prebuild": "node scripts/fetch-render-assets.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "vue": "^3.5.21",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "vite": "^8.3.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
