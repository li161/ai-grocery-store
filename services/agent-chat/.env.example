# Do not commit real secrets.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
ALLOWED_ORIGINS=https://airetail.store,https://www.airetail.store,http://localhost:5173
PORT=8787
AGENT_TIMEOUT_MS=60000
RATE_LIMIT_MAX=30

# Configure PostgreSQL to persist both harness task records and chat conversations across restarts.
# DATABASE_URL=postgresql://user:password@host:5432/database
# PGSSLMODE=disable # only for local PostgreSQL without TLS
